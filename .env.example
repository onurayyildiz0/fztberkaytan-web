# MongoDB bağlantı adresi (yerel veya MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=fizyoterapi

# Auth.js gizli anahtarı: `npx auth secret` veya `openssl rand -base64 32` ile üretin
AUTH_SECRET=
# Vercel dışı sunucularda (next start) gerekli
AUTH_TRUST_HOST=true
# Production site adresi (e-postalardaki linkler için de kullanılır)
# AUTH_URL=https://www.ornek.com

# Bu e-posta ile giriş yapan kullanıcı admin olur.
# Değiştirdikten sonra: npm run admin:password -- "YeniSifre123"
ADMIN_EMAIL=

# Resend (https://resend.com/api-keys) — deneme: npm run email:test -- adres@ornek.com
RESEND_API_KEY=
# Doğrulanmış alan adı ile: "Fizyoterapist Berkay Tan <randevu@alanadiniz.com>"
EMAIL_FROM=Fizyoterapist Berkay Tan <onboarding@resend.dev>

# Google Takvim (iki yönlü senkron, servis hesabı)
# 1) Google Cloud'da proje → Google Calendar API'yi etkinleştir → servis hesabı oluştur → JSON anahtar indir
# 2) Google Takvim → Ayarlar → takvimi paylaş → servis hesabı e-postası → "Etkinliklerde değişiklik yapma"
# 3) Anahtarı buraya yazmak için: npm run google:key -- "indirilen.json" (ardından JSON dosyasını silin)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# JSON anahtardaki "private_key" değeri (tırnak içinde, \n karakterleriyle birlikte)
GOOGLE_PRIVATE_KEY=
# Takvim kimliği: kişisel takvim için Gmail adresi (ör. fztberkay@gmail.com)
GOOGLE_CALENDAR_ID=

# Günlük otomatik görev (hatırlatma e-postaları): /api/cron/daily
# Vercel'de otomatik gönderilir; başka sunucuda "Authorization: Bearer <CRON_SECRET>" başlığıyla çağrılmalı
CRON_SECRET=
